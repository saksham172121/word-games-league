rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One document per player per day, named "YYYY-MM-DD_player".
    match /entries/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.player in ['saksham', 'soukhya']
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && id == request.resource.data.date + '_' + request.resource.data.player
        && request.resource.data.games is map
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 300;
      allow delete: if false;
    }

    // Optional reviews of the dad jokes (readable in Saksham's secret panel).
    match /jokeReviews/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 300
        && request.resource.data.joke is string
        && request.resource.data.joke.size() <= 500;
      allow update, delete: if false;
    }

    // App switches (secret panel): dad-joke popup + which push notifications are allowed.
    match /settings/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && ((id == 'dadjokes' && request.resource.data.enabled is bool)
          || (id == 'push'
              && request.resource.data.posted is bool
              && request.resource.data.morning is bool
              && request.resource.data.evening is bool));
      allow delete: if false;
    }

    // Titles/nicknames: each player writes the OTHER player's title (doc id = whose title it is).
    match /nicknames/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && id in ['saksham', 'soukhya']
        && request.resource.data.nick is string
        && request.resource.data.nick.size() <= 120
        && request.resource.data.by in ['saksham', 'soukhya']
        && request.resource.data.by != id;
      allow delete: if false;
    }

    // Which app version each phone is running (shown in Saksham's secret panel) + one-time scroll flag.
    match /devices/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && id in ['saksham', 'soukhya']
        && request.resource.data.version is string
        && request.resource.data.version.size() <= 20
        && request.resource.data.lastSeen is number;
      allow delete: if false;
    }
  }
}
